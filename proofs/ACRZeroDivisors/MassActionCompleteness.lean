import proofs.ACRZeroDivisors.BlockAlgorithm
import proofs.ACRZeroDivisors.MassActionIdealBridge

namespace ACRZeroDivisors
open MvPolynomial

theorem renamed_rational_ideal_cast {n : ℕ} {σ : Type*}
    (rs : List (Reaction n)) (e : Fin n ≃ Option σ) :
    ((rationalSteadyIdeal rs).map (rename e).toRingHom).map (map (algebraMap ℚ ℝ)) =
      (steadyIdeal rs).map (rename e).toRingHom := by
  rw [← rational_ideal_cast rs,Ideal.map_map,Ideal.map_map]
  congr 1
  apply RingHom.ext
  intro p
  exact map_rename (algebraMap ℚ ℝ) e p

def SpeciesCoordinateCandidate {n : ℕ} (I : Ideal (MvPolynomial (Fin n) ℝ))
    (i : Fin n) (a : ℝ) : Prop :=
  X i - C a ∈ I ∨ ∃ p, p ∉ I ∧ (X i - C a)*p ∈ I

/-- Source-connected corrected Algorithm 1: the ideal is generated by the
literal rational-rate mass-action field, with no saturation or elimination
replacement of that original ideal. -/
theorem mass_action_block_algorithm_complete {n : ℕ} {σ ι : Type*} [Fintype ι]
    (rs : List (Reaction n)) (e : Fin n ≃ Option σ)
    (full : MonomialOrder (Option σ)) (z : MonomialOrder σ)
    (hblock : BlockCompatible full z) (b : ι → MvPolynomial (Option σ) ℚ)
    (hcover : HasLeadingCover full ((rationalSteadyIdeal rs).map (rename e).toRingHom) b)
    (hgen : ∀ i, b i ∈ (rationalSteadyIdeal rs).map (rename e).toRingHom)
    (a : ℝ) (hac : NonvacuousACR rs (e.symm none) a)
    (hc : SpeciesCoordinateCandidate (steadyIdeal rs) (e.symm none) a) :
    BlockAlgorithmCandidates z b a := by
  obtain ⟨x,hx⟩ := hac.1
  have hxa : x (e.symm none) = a := hac.2 x hx
  have ha : 0 < a := hxa ▸ hx.1 (e.symm none)
  apply block_algorithm_complete full z hblock _ b hcover hgen a ha (x ∘ e.symm) hxa
  · rw [renamed_rational_ideal_cast]
    intro p hp
    obtain ⟨q,hq,rfl⟩ := (Ideal.mem_map_iff_of_surjective
      (rename e).toRingHom (renameEquiv ℝ e).surjective).mp hp
    change eval (x ∘ e.symm) (rename e q) = 0
    rw [eval_rename]
    simpa only [Function.comp_assoc,Equiv.symm_comp_self,Function.comp_id] using
      positive_steady_annihilates_ideal rs x hx q hq
  · rw [renamed_rational_ideal_cast]
    rcases hc with hm | ⟨p,hp,ht⟩
    · left
      have h := Ideal.mem_map_of_mem (rename e).toRingHom hm
      simpa using h
    · right
      refine ⟨rename e p,?_,?_⟩
      · intro h
        obtain ⟨q,hq,heq⟩ := (Ideal.mem_map_iff_of_surjective
          (rename e).toRingHom (renameEquiv ℝ e).surjective).mp h
        exact hp ((renameEquiv ℝ e).injective heq ▸ hq)
      · have h := Ideal.mem_map_of_mem (rename e).toRingHom ht
        simpa using h

end ACRZeroDivisors
